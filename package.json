{
  "name": "eavi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:browser": "node scripts/browserSmoke.ts http://localhost:5173/?debug --chrome",
