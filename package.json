  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "jsdom": "^26.1.0",
    "mpg123-decoder": "1.0.3",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@vercel/functions": "^3.4.3",
    "@vgpu/wgsl": "0.6.0",
    "vgpu": "0.6.0"
  }
}
